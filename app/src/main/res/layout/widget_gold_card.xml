<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gold_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_gold_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Refresh Button -->
        <ImageView
            android:id="@+id/gold_widget_btn_refresh"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="3dp"
            android:background="@android:color/transparent"
            android:contentDescription="بروزرسانی نرخ طلا و سکه"
            android:src="@drawable/ic_widget_refresh" />

        <!-- Timestamp -->
        <TextView
            android:id="@+id/gold_widget_last_updated"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="بروزرسانی: لحظاتی پیش"
            android:textColor="#A89B84"
            android:textSize="10sp" />

        <!-- Asset Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🪙 طلا و سکه زنده"
            android:textColor="#FFD700"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Divider Line -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#38301D"
        android:src="@android:color/transparent" />

    <!-- Big Price & Change Block for Gold 18K -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 24h Change Badge -->
            <TextView
                android:id="@+id/gold_widget_change"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_gold_item_bg"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="-۲.۰۵٪"
                android:textColor="#FF5252"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <!-- Main Live 18K Gold Price -->
            <TextView
                android:id="@+id/gold_widget_price"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="right|end"
                android:text="۲۶,۲۰۰,۶۰۰ تومان"
                android:textColor="#FFD700"
                android:textSize="18.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Secondary Information Card (Coin & Ounce) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/widget_gold_item_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/gold_widget_ounce"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="انس: $۴,۰۸۵"
                android:textColor="#FFD54F"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/gold_widget_coin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="right|end"
                android:text="سکه امامی: ۲۶۷,۳۶۵,۰۰۰ ت"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- High/Low 24h Range -->
        <TextView
            android:id="@+id/gold_widget_range"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="right|end"
            android:text="سقف: ۲۶,۷۴۰,۰۰۰ | کف: ۲۶,۱۳۰,۰۰۰"
            android:textColor="#A89B84"
            android:textSize="9.5sp" />
    </LinearLayout>

</LinearLayout>
