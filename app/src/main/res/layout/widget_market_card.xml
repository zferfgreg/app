<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Refresh Button (Using compliant ImageView + PNG icon) -->
        <ImageView
            android:id="@+id/widget_btn_refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:background="@android:color/transparent"
            android:contentDescription="بروزرسانی نرخ‌ها"
            android:src="@drawable/ic_widget_refresh" />

        <!-- Timestamp -->
        <TextView
            android:id="@+id/widget_last_updated"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="بروزرسانی: لحظاتی پیش"
            android:textColor="#8C9BB4"
            android:textSize="10sp" />

        <!-- App Brand & Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EXCHANCE 💎"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Divider Line using ImageView (RemoteViews-compliant) -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#262D3E"
        android:src="@android:color/transparent" />

    <!-- 4 Main Asset Rows -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 1. Dollar USD -->
        <LinearLayout
            android:id="@+id/widget_row_usd"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_item_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/widget_change_usd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+۲.۱٪"
                android:textColor="#00E676"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_price_usd"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="۲۶۳,۲۰۰ تومان"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💵 دلار آمریکا"
                android:textColor="#E0E6ED"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 2. Gold 18K -->
        <LinearLayout
            android:id="@+id/widget_row_gold"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_item_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/widget_change_gold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-۲.۰٪"
                android:textColor="#FF5252"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_price_gold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="۲۶,۲۰۰,۰۰۰ تومان"
                android:textColor="#FFD700"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🪙 طلای ۱۸ عیار"
                android:textColor="#E0E6ED"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 3. Emami Coin -->
        <LinearLayout
            android:id="@+id/widget_row_coin"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_item_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/widget_change_coin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-۱.۷٪"
                android:textColor="#FF5252"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_price_coin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="۲۶۷,۲۵۰,۰۰۰ تومان"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🪙 سکه امامی"
                android:textColor="#E0E6ED"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 4. Tether & Bitcoin -->
        <LinearLayout
            android:id="@+id/widget_row_crypto"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/widget_item_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/widget_change_crypto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+۱.۲٪"
                android:textColor="#00E676"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_price_crypto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="۲۶۴,۰۰۰ ت | $۸۳K"
                android:textColor="#00E5FF"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ تتر و بیت‌کوین"
                android:textColor="#E0E6ED"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
